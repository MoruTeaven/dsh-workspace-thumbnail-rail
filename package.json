{
  "name": "@moruteaven/dsh-workspace-thumbnail-rail",
  "version": "0.1.0-dev.1",
  "description": "Workspace thumbnail rail for the DeepSeek Harness (DSH) — give every workspace an icon image and switch between workspaces from a vertical rail beside the conversation.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "prepare": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "esbuild src/self-test.ts --bundle --format=esm --platform=node --outfile=lib/self-test.mjs && node lib/self-test.mjs",
    "test:frame": "esbuild src/frame-test.ts --bundle --format=esm --platform=node --outfile=lib/frame-test.mjs && node lib/frame-test.mjs",
    "test": "pnpm run typecheck && pnpm run test:unit && pnpm run test:frame"
  },
  "files": [
    "lib/client.js",
    "lib/index.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "author": "抹露茶柒 (MoruTeaven) <me@MoruTeaven.com> (www.MoruTeaven.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoruTeaven/dsh-workspace-thumbnail-rail.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "dsh-plugin",
    "workspace",
    "thumbnail",
    "rail",
    "sidebar",
    "switcher"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "homepage": "https://github.com/MoruTeaven/dsh-workspace-thumbnail-rail#readme"
}